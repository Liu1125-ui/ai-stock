# Local Compose only; generate ignored .env with scripts/init-local-env.ps1.
MYSQL_ROOT_PASSWORD=replace_with_random_secret
SERVICE_TOKEN=replace_with_random_secret
USER_DB_PASSWORD=replace_with_random_secret
MARKET_DB_PASSWORD=replace_with_random_secret
PREDICTION_DB_PASSWORD=replace_with_random_secret
SCHEDULER_DB_PASSWORD=replace_with_random_secret
NOTIFICATION_DB_PASSWORD=replace_with_random_secret
MAIL_PAYLOAD_KEY=replace_with_64_hex_characters
MAIL_DIGEST_KEY=replace_with_64_hex_characters
AUTH_DIGEST_KEY=replace_with_64_hex_characters
AUTH_PAYLOAD_KEY=replace_with_64_hex_characters
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your_email_address
SMTP_PASSWORD=configure_locally_do_not_commit
SMTP_FROM=your_email_address
SMTP_SSL_ENABLED=true
SMTP_STARTTLS_REQUIRED=false
# Explicitly enable after real source verification; local market refresh only.
MARKET_WORKER_ENABLED=false
MARKET_PLAN_ENABLED=false
PREDICTION_VERIFY_PLAN_ENABLED=false
MARKET_PLAN_INSTRUMENTS=SH600030,SH600276,SZ000002

# RAW修订事件重核计划（同时要求MARKET_WORKER_ENABLED=true）
PREDICTION_REVISION_PLAN_ENABLED=false

# MaaS: configure locally with scripts/配置MaaS.cmd; never commit the key
MAAS_ENABLED=false
MAAS_CHAT_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_MODEL=deepseek-v4-flash
MAAS_API_KEY=

# Per-user alert rule count policy; automatic evaluation/delivery is not enabled.
ALERT_MAX_RULES=50
# Enable only together with the deployed alert planner and worker.
ALERT_EVALUATION_ENABLED=false

# 日线预警：Task7部署验收前保持关闭；邮件仍独立C阶段。
ALERT_PLAN_ENABLED=false
ALERT_WORKER_ENABLED=false
ALERT_SCAN_POLL_MS=60000
ALERT_WORKER_POLL_MS=1000
ALERT_RECONCILE_MINUTES=60
ALERT_PAGE_SIZE=50
ALERT_MAX_ACTIVE_JOBS=1000
ALERT_INSTRUMENTS=SH600030,SH600276,SZ000002

# 预警邮件独立开关：默认关闭，真实外发需先确认收件人与数量。
ALERT_MAIL_WORKER_ENABLED=false
ALERT_MAIL_TTL_SECONDS=86400
ALERT_MAIL_MAX_ATTEMPTS=3
ALERT_MAIL_LEASE_SECONDS=120
ALERT_MAIL_POLL_MS=2000
ALERT_MAIL_RETRY_INITIAL_SECONDS=60
ALERT_MAIL_RETRY_LATER_SECONDS=300

# Comparison explanations are enabled only after controlled verification.
COMPARISON_AI_ENABLED=false
# Saved portfolio questions stay disabled until explicit acceptance-call approval.
PORTFOLIO_QUESTION_ENABLED=false
# 比较证据持续更新：默认关闭，真实首验必须仅单股且max-attempts=1。
COMPARISON_UPDATE_PLAN_ENABLED=false
COMPARISON_UPDATE_WORKER_ENABLED=false
COMPARISON_UPDATE_INSTRUMENTS=SH600030,SH600276,SZ000002
COMPARISON_UPDATE_SCAN_POLL_MS=60000
COMPARISON_UPDATE_MAX_ATTEMPTS=3
COMPARISON_UPDATE_RETRY_FIRST_SECONDS=900
COMPARISON_UPDATE_RETRY_SECOND_SECONDS=1800

# 管理员任务受控操作：默认关闭，真实写链路验收后再按授权启用
ADMIN_TASK_ACTIONS_ENABLED=false
ADMIN_TASK_RETRY_COOLDOWN_SECONDS=60

# 管理员行情重取；真实验收限定股票/日期/供应商预算后开启
ADMIN_MARKET_REFRESH_ACTIONS_ENABLED=false
ADMIN_MARKET_REFRESH_COOLDOWN_SECONDS=60

# 注册中心仅宿主访问端口；服务间仍使用nacos:8848
NACOS_HOST_PORT=18488

# 本地独立运行行情引用聚合地址；Compose使用业务服务DNS
REFERENCE_PREDICTION_URL=http://127.0.0.1:18083
REFERENCE_SCHEDULER_URL=http://127.0.0.1:18084
REFERENCE_NOTIFICATION_URL=http://127.0.0.1:18085

# SDD010B3: protocol staging only; consumer enforcement is not integrated yet.
MARKET_VERSION_USE_PROTOCOL_ENABLED=false
MARKET_VERSION_USE_RECONCILE_ENABLED=false
MARKET_VERSION_USE_ENFORCED=false
MARKET_VERSION_EVIDENCE_GATES_ENABLED=false

# Analysis owner integration only; global enforcement remains unavailable.
PREDICTION_MARKET_USE_ANALYSIS_ENABLED=false
PREDICTION_MARKET_USE_RECOVERY_ENABLED=false

PREDICTION_MARKET_USE_FORECAST_ENABLED=false
PREDICTION_MARKET_USE_VERIFICATION_ENABLED=false
ALGORITHM_MARKET_VERSION_USE_REQUIRED=false

PREDICTION_MARKET_USE_COMPARISON_ENABLED=false
PREDICTION_MARKET_USE_PORTFOLIO_ENABLED=false

NOTIFICATION_MARKET_USE_ALERT_ENABLED=false
NOTIFICATION_MARKET_USE_RECOVERY_ENABLED=false

MARKET_LOCAL_COMPARISON_USE_ENABLED=false
MARKET_LOCAL_COMPARISON_USE_RECOVERY_ENABLED=false

MARKET_LOCAL_ALERT_USE_ENABLED=false
MARKET_LOCAL_ALERT_USE_RECOVERY_ENABLED=false
